NODE_ENV=development
# SSD-Backend is the merged Auth/Users/Roles/Customers/Masters/POS/Inventory/
# Payments/Reports API (formerly User-Service + Catalog-Service +
# Payment-Service + Notification-Service, four separate processes/ports).
# One port for the whole thing now. On Render, PORT is injected
# automatically and overrides this default — do not set it manually there.
PORT=5003
API_PREFIX=/api/v1
# Comma-separated — allows a Vercel production domain and its per-branch
# preview domains at once, e.g.
# https://ssd-admin.vercel.app,https://ssd-frontend-git-develop-xxx.vercel.app
CORS_ORIGIN=http://localhost:3000

MONGO_URI=mongodb://127.0.0.1:27017/ssd-temple

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_COST=12

ACTIVATION_TOKEN_TTL_HOURS=48
RESET_TOKEN_TTL_MINUTES=30
MOBILE_OTP_TTL_MINUTES=5

# Points at the deployed SSD-Frontend origin — activation/reset-password
# emails link to ${ADMIN_APP_URL}/admin/activate/:token etc.
ADMIN_APP_URL=http://localhost:3000

# Email header logo — a permanent Cloudinary URL, not built from
# ADMIN_APP_URL, because a `localhost` URL can never be reached by a real
# mail client. Leave unset to use the default temple logo.
EMAIL_LOGO_URL=

# --- Notifications --------------------------------------------------------
# Keep this true until a real email provider + SMS sender are provisioned.
# While true, nothing below is actually called — every email is logged to
# the console and to logs/dry-run-emails.log instead, so the
# activation/forgot-password flow can be tested safely with no keys at all.
DRY_RUN_NOTIFICATIONS=true

# Same dual-provider approach as Syncetra-Backend: Brevo's HTTP API first
# (Gmail SMTP is blocked outbound on Render's free tier), falling back to
# Gmail SMTP for local dev or a paid Render plan. Set ONE of the two pairs
# below. Swap this block for AWS SES once the project moves onto AWS.
BREVO_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDER_EMAIL_ID=no-reply@example-temple.org

# --- Profile image uploads (Cloudinary) ------------------------------------
# See common/utils/cloudinary.js / common/middleware/upload.js. Local disk
# isn't an option on Render (ephemeral filesystem, wiped on every redeploy),
# and this stays unchanged after the move to AWS.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reserved for the mobile-change OTP flow (not wired up yet)
SMS_SENDER_ID=SSDTEMPLE

# --- Seed script ------------------------------------------------------------
DEFAULT_ENTITY_CODE=SST
SEED_SUPER_ADMIN_NAME=Temple System Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@example-temple.org

# --- NETS payment callback (controllers/payments/nets/callback) ------------
# Shared secret between this backend and the local Nets-Service EXE — the
# EXE sends it as the X-Nets-Callback-Secret header on every automatic
# payment confirmation. Leave unset to use config/env.js's own hardcoded
# default, which already matches the EXE's amq/ssdBackendClient.js constant
# — only set this if a real, unique-per-deployment secret is ever wanted.
NETS_CALLBACK_SECRET=
